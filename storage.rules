rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn() && profile().role == 'ADMIN';
    }

    function sameBranch(branchId) {
      return signedIn() &&
        profile().role in ['ADMIN', 'VETERINARIAN', 'CLINIC STAFF'] &&
        profile().branchId == branchId &&
        branchId != '';
    }

    match /documents/{branchId}/{petId}/{fileName} {
      allow read, write: if isAdmin() || sameBranch(branchId);
    }
  }
}
